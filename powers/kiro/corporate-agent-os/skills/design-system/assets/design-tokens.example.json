{
  "meta": {
    "product": "example-dense-operations-ui",
    "version": "0.1.0",
    "contrast_target": "WCAG 2.2 AA",
    "brandbook": "03-brand/brandbook.md",
    "_note": "Illustrative starter that validates against templates/design/design-tokens.schema.json. Replace every value from the project brandbook. Contrast figures are computed by skills/design-system/scripts/contrast_check.py for these exact hex pairs; re-run it after any change."
  },
  "color": {
    "background": {
      "light": "#FFFFFF",
      "dark": "#121417"
    },
    "surface": {
      "light": "#F4F5F7",
      "dark": "#1B1F24"
    },
    "surface-raised": {
      "light": "#FFFFFF",
      "dark": "#232931"
    },
    "border": {
      "light": "#C9CED6",
      "dark": "#3A424D",
      "contrast_against": "background",
      "contrast_light": 1.58,
      "contrast_dark": 1.82,
      "decorative_only": true
    },
    "border-strong": {
      "light": "#8A93A0",
      "dark": "#7C8794",
      "contrast_against": "background",
      "contrast_light": 3.11,
      "contrast_dark": 5.05
    },
    "text-primary": {
      "light": "#16191D",
      "dark": "#F2F4F7",
      "contrast_against": "background",
      "contrast_light": 17.63,
      "contrast_dark": 16.75
    },
    "text-secondary": {
      "light": "#4B5563",
      "dark": "#B4BCC8",
      "contrast_against": "background",
      "contrast_light": 7.56,
      "contrast_dark": 9.64
    },
    "text-on-brand": {
      "light": "#FFFFFF",
      "dark": "#121417",
      "contrast_against": "brand",
      "contrast_light": 6.45,
      "contrast_dark": 8.61
    },
    "brand": {
      "light": "#0B5FAD",
      "dark": "#7FB3FF",
      "contrast_against": "background",
      "contrast_light": 6.45,
      "contrast_dark": 8.61
    },
    "brand-subtle": {
      "light": "#E3EEF9",
      "dark": "#15304D",
      "decorative_only": true
    },
    "focus": {
      "light": "#0B5FAD",
      "dark": "#7FB3FF",
      "contrast_against": "background",
      "contrast_light": 6.45,
      "contrast_dark": 8.61
    },
    "status-success": {
      "light": "#1B6E3A",
      "dark": "#6FCF97",
      "contrast_against": "background",
      "contrast_light": 6.29,
      "contrast_dark": 9.71
    },
    "status-warning": {
      "light": "#8A5A00",
      "dark": "#F2C14E",
      "contrast_against": "background",
      "contrast_light": 5.93,
      "contrast_dark": 10.99
    },
    "status-danger": {
      "light": "#A61B1B",
      "dark": "#FF8A80",
      "contrast_against": "background",
      "contrast_light": 7.52,
      "contrast_dark": 8.08
    },
    "status-info": {
      "light": "#0B5FAD",
      "dark": "#7FB3FF",
      "contrast_against": "background",
      "contrast_light": 6.45,
      "contrast_dark": 8.61
    }
  },
  "typography": {
    "families": {
      "ui": {
        "stack": "\"Source Sans 3\", \"Segoe UI\", Roboto, system-ui, sans-serif",
        "license": "SIL Open Font License 1.1 (record the exact source and version in asset-provenance.md)",
        "weights": [
          400,
          600,
          700
        ]
      },
      "mono": {
        "stack": "\"JetBrains Mono\", Consolas, \"SF Mono\", monospace",
        "license": "SIL Open Font License 1.1 (record source and version)",
        "weights": [
          400
        ]
      }
    },
    "scale": {
      "caption": {
        "size": "0.75rem",
        "line_height": "1.4",
        "weight": 400
      },
      "body-sm": {
        "size": "0.875rem",
        "line_height": "1.45",
        "weight": 400
      },
      "body": {
        "size": "1rem",
        "line_height": "1.5",
        "weight": 400
      },
      "label": {
        "size": "0.875rem",
        "line_height": "1.3",
        "weight": 600,
        "tracking": "0.01em"
      },
      "title-sm": {
        "size": "1.125rem",
        "line_height": "1.35",
        "weight": 600
      },
      "title": {
        "size": "1.375rem",
        "line_height": "1.3",
        "weight": 700
      },
      "display": {
        "size": "1.75rem",
        "line_height": "1.2",
        "weight": 700
      }
    }
  },
  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px"
  },
  "radius": {
    "none": "0px",
    "sm": "4px",
    "md": "6px",
    "pill": "999px"
  },
  "elevation": {
    "0": "none",
    "1": "0 1px 2px rgba(0,0,0,0.12)",
    "2": "0 4px 12px rgba(0,0,0,0.16)"
  },
  "motion": {
    "durations": {
      "instant": "80ms",
      "fast": "140ms",
      "base": "220ms",
      "slow": "320ms"
    },
    "easings": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    },
    "reduced_motion": "Disable movement-based transitions; keep opacity changes under 100ms; never auto-animate data updates."
  },
  "focus": {
    "ring": "2px solid {color.focus}",
    "offset": "2px"
  },
  "breakpoints": {
    "sm": "360px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px"
  }
}
