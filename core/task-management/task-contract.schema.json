{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corporate-agent-os.local/schemas/task-contract.schema.json",
  "title": "Corporate Agent OS task contract",
  "description": "One unit of delegated work. Every agent task must satisfy this contract before it is assigned.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id", "project_id", "assigned_agent", "objective", "context", "inputs", "outputs",
    "file_ownership", "dependencies", "constraints", "tools", "budget", "timeout_minutes",
    "acceptance_criteria", "verification", "risk", "approval", "status"
  ],
  "properties": {
    "task_id": { "type": "string", "pattern": "^T-[0-9]{3,}$", "description": "Unique within the project, e.g. T-014." },
    "project_id": { "type": "string", "minLength": 1 },
    "assigned_agent": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Agent id from agents/**." },
    "reviewer": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Independent reviewer agent id. Must differ from assigned_agent when present." },
    "objective": { "type": "string", "minLength": 20, "description": "One or two sentences stating the outcome, not the activity." },
    "context": { "type": "string", "minLength": 1, "description": "Why the task exists and which decision it informs. May reference memory ledger ids." },
    "inputs": { "type": "array", "items": { "type": "string" }, "description": "Paths or ledger ids the agent must read." },
    "outputs": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Exact artefact paths the agent must produce." },
    "file_ownership": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Glob patterns the agent may write. Nothing else." },
    "dependencies": { "type": "array", "items": { "type": "string", "pattern": "^T-[0-9]{3,}$" } },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "tools": { "type": "array", "items": { "type": "string", "enum": ["read", "write", "shell", "web", "subagent", "browser", "mcp"] } },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_model_calls", "max_retries"],
      "properties": {
        "max_model_calls": { "type": "integer", "minimum": 1 },
        "max_retries": { "type": "integer", "minimum": 0, "maximum": 3 },
        "max_tokens": { "type": "integer", "minimum": 1 },
        "max_cost_usd": { "type": "number", "minimum": 0 }
      }
    },
    "timeout_minutes": { "type": "integer", "minimum": 1 },
    "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10 }, "description": "Testable statements. Avoid 'good', 'intuitive', 'secure' without a measurable definition." },
    "verification": { "type": "string", "minLength": 10, "description": "How the reviewer will check the criteria: command, inspection, comparison." },
    "risk": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "approval": {
      "type": "array",
      "items": { "type": "string", "enum": ["none", "department-lead", "executive", "human", "legal-counsel", "security-lead"] },
      "minItems": 1
    },
    "status": { "type": "string", "enum": ["PROPOSED", "READY", "RUNNING", "REVIEW", "REWORK", "BLOCKED", "ACCEPTED", "REJECTED", "CANCELLED"] },
    "created_at": { "type": "string", "description": "ISO-8601 timestamp." },
    "updated_at": { "type": "string", "description": "ISO-8601 timestamp." },
    "notes": { "type": "string" }
  }
}
