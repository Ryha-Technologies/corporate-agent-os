{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corporate-agent-os.local/schemas/memory-entry.schema.json",
  "title": "Project memory ledger entry",
  "description": "One line of 10-decisions/memory-ledger.jsonl. Every statement carries its type, provenance and confidence so that assumptions never silently become facts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "statement", "provenance", "confidence", "recorded_by", "recorded_at", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^(F|H|A|R|D|K|L|Q|X)-[0-9]{3,}$", "description": "Prefix encodes type: F fact, H hypothesis, A assumption, R recommendation, D decision, K risk, L lesson, Q open question, X rejected alternative." },
    "type": { "type": "string", "enum": ["fact", "hypothesis", "assumption", "recommendation", "decision", "risk", "lesson", "open_question", "rejected_alternative"] },
    "category": { "type": "string", "enum": ["requirement", "business_context", "research_finding", "architecture", "design", "brand", "technical_constraint", "status", "other"] },
    "statement": { "type": "string", "minLength": 10 },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["user_statement", "primary_source", "secondary_source", "observation", "experiment", "agent_inference", "human_decision"] },
        "source": { "type": "string", "description": "URL, file path, ledger id or person role." },
        "published": { "type": "string" },
        "accessed": { "type": "string" },
        "limitation": { "type": "string" }
      }
    },
    "confidence": { "type": "string", "enum": ["high", "medium", "low", "n/a"] },
    "recorded_by": { "type": "string", "description": "Agent id or 'human:<role>'." },
    "recorded_at": { "type": "string", "description": "ISO-8601 timestamp." },
    "status": { "type": "string", "enum": ["active", "superseded", "withdrawn", "resolved"] },
    "supersedes": { "type": "string" },
    "related": { "type": "array", "items": { "type": "string" } },
    "review_by": { "type": "string", "description": "Date by which a hypothesis or assumption must be tested or withdrawn." }
  }
}
