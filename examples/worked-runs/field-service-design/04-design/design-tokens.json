{
  "meta": {
    "product": "kaamline (working title, unscreened)",
    "version": "0.1.0",
    "contrast_target": "WCAG 2.2 AA",
    "brandbook": "03-brand/brandbook.md (draft 0.1)",
    "_note": "Design-run tokens. Contrast values computed by contrast_check.py. Body text targets >= 7:1 for outdoor legibility (A-003). Fonts are placeholders pending licence and script-coverage confirmation (A-007)."
  },
  "color": {
    "background": {
      "light": "#FBFAF7",
      "dark": "#16131F"
