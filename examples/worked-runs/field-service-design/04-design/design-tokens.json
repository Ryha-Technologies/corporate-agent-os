  "typography": {
    "families": {
      "ui": {
        "stack": "\"Anek Latin\", \"Anek Devanagari\", \"Anek Tamil\", system-ui, sans-serif",
        "license": "SIL Open Font License 1.1 (github.com/EkType/Anek OFL.txt, accessed 2026-11-18); pin release tag before shipping",
        "weights": [
          400,
          600,
          700
        ]
      }
    },
    "scale": {
      "caption": {
        "size": "0.75rem",
        "line_height": "1.4",
        "weight": 400
      },
      "body-sm": {
        "size": "0.875rem",
        "line_height": "1.45",
        "weight": 400
      },
      "body": {
        "size": "1rem",
        "line_height": "1.5",
        "weight": 400
      },
      "label": {
        "size": "0.875rem",
        "line_height": "1.3",
        "weight": 600,
        "tracking": "0.01em"
      },
      "title-sm": {
        "size": "1.125rem",
        "line_height": "1.35",
        "weight": 600
      },
      "title": {
        "size": "1.375rem",
        "line_height": "1.3",
        "weight": 700
      },
      "display": {
        "size": "1.75rem",
        "line_height": "1.2",
        "weight": 700
      },
      "next-job": {
        "size": "1.25rem",
        "line_height": "1.3",
        "weight": 700
      }
    }
  },
  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px",
    "row-compact": "32px",
    "row-comfortable": "56px",
    "target-min": "44px"
  },
  "radius": {
    "none": "0px",
    "sm": "4px",
    "md": "6px",
    "pill": "999px"
  },
  "elevation": {
    "0": "none",
    "1": "0 1px 2px rgba(0,0,0,0.12)",
    "2": "0 4px 12px rgba(0,0,0,0.16)"
  },
  "motion": {
    "durations": {
      "instant": "80ms",
      "fast": "140ms",
      "base": "220ms",
      "slow": "320ms"
    },
    "easings": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    },
    "reduced_motion": "Disable movement-based transitions; keep opacity changes under 100ms; never auto-animate data updates."
  },
  "focus": {
    "ring": "2px solid {color.focus}",
    "offset": "2px"
  },
  "breakpoints": {
    "sm": "360px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px"
  }
}
